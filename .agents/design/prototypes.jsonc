// prototypes.jsonc — click-through prototypes built from this repo's design system.
// Framework-agnostic scene graph (not shipping code): layout primitives + references to
// components.jsonc by name + navigation as data. Copilot authors/patches this; review it in
// the Prototype canvas. Node kinds: layout | component | text | image | spacer. Every node
// may carry id, on (interactions), visibleWhen/hiddenWhen. Actions: navigate, back,
// setState, toggle, openModal, closeModal. This file is regenerated with stable key order
// Layouts: stack, row, grid, scroll, freeform, none. Common fields: width/height
// (hug, fill, pixels or CSS length), gap, padding/margin (token, pixels or edge box),
// appearance (sparse component-system overrides). Only direct freeform children may
// carry position: { mode: "absolute", x, y }. Appearance overrides legacy flat styles.
// Optional sections: [{ id, name }]. A screen's sectionId assigns it to a sidebar group.
// on save — use "note" fields for durable annotations.
{
  "meta": {
    "version": 1,
    "updatedBy": "copilot",
    "updatedAt": "2026-10-08T16:46:01.797Z",
    "name": "Colophon Inspect interactions",
    "note": "Click-through proposal for selection, drop feedback, resize, and save. Direct manipulation is implemented in the Colophon canvas."
  },
  "state": {
    "step": "select"
  },
  "screens": [
    {
      "id": "inspect-workspace",
      "name": "Inspect workspace",
      "device": "responsive",
      "root": {
        "id": "workspace",
        "layout": "stack",
        "gap": "4",
        "padding": "5",
        "background": "paper",
        "children": [
          {
            "id": "title",
            "text": "Inspect, without losing the system",
            "style": "title"
          },
          {
            "id": "intro",
            "text": "Create a layer. Preview its destination. Resize it. Save the same token-bound component graph.",
            "style": "small",
            "color": "muted"
          },
          {
            "id": "steps",
            "layout": "row",
            "gap": "3",
            "children": [
              {
                "id": "select-step",
                "component": "Button",
                "props": {
                  "children": "1. Select",
                  "variant": "secondary"
                },
                "on": {
                  "tap": {
                    "setState": {
                      "step": "select"
                    }
                  }
                }
              },
              {
                "id": "drop-step",
                "component": "Button",
                "props": {
                  "children": "2. Preview drop",
                  "variant": "secondary"
                },
                "on": {
                  "tap": {
                    "setState": {
                      "step": "drop"
                    }
                  }
                }
              },
              {
                "id": "resize-step",
                "component": "Button",
                "props": {
                  "children": "3. Resize",
                  "variant": "secondary"
                },
                "on": {
                  "tap": {
                    "setState": {
                      "step": "resize"
                    }
                  }
                }
              }
            ]
          },
          {
            "id": "panes",
            "layout": "grid",
            "columns": 3,
            "gap": "4",
            "children": [
              {
                "id": "layers",
                "layout": "stack",
                "gap": "3",
                "padding": "4",
                "background": "surface",
                "children": [
                  {
                    "id": "layers-heading",
                    "text": "Layers + Insert",
                    "style": "heading"
                  },
                  {
                    "id": "frame-item",
                    "text": "Frame  /  field-notes",
                    "style": "small"
                  },
                  {
                    "id": "title-item",
                    "text": "Text  /  heading",
                    "style": "small"
                  },
                  {
                    "id": "instance-item",
                    "text": "Instance  /  Card",
                    "style": "small",
                    "color": "selection"
                  },
                  {
                    "id": "insert-help",
                    "text": "Insert frame, text, rectangle, or an existing component. Click or drag to place.",
                    "style": "small",
                    "color": "muted"
                  }
                ]
              },
              {
                "id": "preview",
                "layout": "stack",
                "gap": "4",
                "padding": "4",
                "background": "surface",
                "children": [
                  {
                    "id": "preview-heading",
                    "text": "Component canvas",
                    "style": "heading"
                  },
                  {
                    "id": "selected",
                    "component": "Card",
                    "props": {
                      "body": "A reusable Northlight component.",
                      "title": "Field notes"
                    }
                  },
                  {
                    "id": "selected-cue",
                    "text": "Selected: card-root. Resize handles appear on its bounds.",
                    "style": "small",
                    "color": "selection",
                    "visibleWhen": {
                      "step": "select"
                    }
                  },
                  {
                    "id": "drop-cue",
                    "layout": "stack",
                    "padding": "3",
                    "appearance": {
                      "borderColor": "selection",
                      "borderWidth": 2
                    },
                    "visibleWhen": {
                      "step": "drop"
                    },
                    "children": [
                      {
                        "id": "drop-label",
                        "text": "Inside field-notes",
                        "style": "small",
                        "color": "selection"
                      },
                      {
                        "id": "drop-help",
                        "text": "Blue outlines mark valid containers. A line marks insertion between siblings. Escape cancels.",
                        "style": "small"
                      }
                    ]
                  },
                  {
                    "id": "resize-cue",
                    "text": "320 x 180. Shift locks the corner ratio. One release, one undo step.",
