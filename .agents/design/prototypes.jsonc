                    "color": "selection",
                    "visibleWhen": {
                      "step": "resize"
                    }
                  }
                ]
              },
              {
                "id": "properties",
                "layout": "stack",
                "gap": "3",
                "padding": "4",
                "background": "surface",
                "children": [
                  {
                    "id": "properties-heading",
                    "text": "Properties",
                    "style": "heading"
                  },
                  {
                    "id": "properties-dock",
                    "text": "Dock on either side",
                    "style": "caption",
