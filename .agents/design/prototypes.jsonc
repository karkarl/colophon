                    "text": "Size: fixed, hug, or fill",
                    "style": "small"
                  },
                  {
                    "id": "appearance-label",
                    "text": "Appearance: surface / ink / radius md",
                    "style": "small"
                  },
                  {
                    "id": "scale-help",
                    "text": "Scale geometry changes fixed dimensions, not shared type or spacing tokens. Zoom changes only the viewport.",
                    "style": "small",
                    "color": "muted"
                  },
                  {
                    "id": "save",
                    "component": "Button",
                    "props": {
                      "children": "Review save behavior",
                      "variant": "primary"
                    },
                    "on": {
                      "tap": {
                        "navigate": "inspect-save"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "inspect-save",
      "name": "Save and recover",
      "device": "responsive",
      "root": {
        "id": "save-workspace",
        "layout": "stack",
        "gap": "5",
        "padding": "6",
        "background": "paper",
        "children": [
          {
            "id": "save-title",
            "text": "Your graph stays the source",
            "style": "title"
          },
          {
            "id": "save-body",
            "text": "Completed gestures stay in the draft until Save to repo. Undo and redo operate on complete edits. Cancelling a gesture leaves the graph unchanged.",
            "style": "body"
          },
          {
            "id": "save-note",
            "text": "No token detachment. No automatic publishing. Exact JSON and Send to chat remain available.",
            "style": "small",
            "color": "muted"
          },
          {
            "id": "back",
            "component": "Button",
            "props": {
              "children": "Back to Inspect",
              "variant": "secondary"
            },
            "on": {
              "tap": {
                "navigate": "inspect-workspace"
              }
            }
          }
        ]
      }
    }
  ],
  "flows": [
    {
      "id": "inspect",
      "name": "Create, place, resize, and save",
