        "children": [
          {
            "id": "save-title",
            "text": "Your graph stays the source",
            "style": "title"
          },
          {
            "id": "save-body",
            "text": "Completed gestures stay in the draft until Save to repo. Undo and redo operate on complete edits. Cancelling a gesture leaves the graph unchanged.",
            "style": "body"
          },
          {
            "id": "save-note",
            "text": "No token detachment. No automatic publishing. Exact JSON and Send to chat remain available.",
            "style": "small",
            "color": "muted"
          },
