                    "color": "muted"
                  }
                ]
              },
              {
                "id": "preview",
                "layout": "stack",
                "gap": "4",
                "padding": "4",
                "background": "surface",
                "children": [
                  {
                    "id": "preview-heading",
                    "text": "Component canvas",
                    "style": "heading"
                  },
                  {
                    "id": "selected",
                    "component": "Card",
                    "props": {
                      "body": "A reusable Northlight component.",
