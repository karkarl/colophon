// components.jsonc — the UI patterns your team has already decided on, as data.
//
// This is a framework-agnostic relational element tree with token-bound Auto Layout
// and optional parent-relative freeform positioning. It renders
// live in the Colophon and Prototype canvases and ports cleanly to web, WinUI, and
// SwiftUI because layout intent is semantic rather than executable CSS.
//
// Every object node has a stable `id`, used for selection, layer moves, and surgical
// edits. Node kinds:
//   element   { "id": "...", "el": "button", "class": "...", "attrs": {},
//               "layout": {}, "position": {}, "margin": {}, "appearance": {}, "children": [] }
//   component { "id": "...", "component": "Badge", "props": {},
//               "layout": {}, "position": {}, "margin": {}, "appearance": {} }
//   string    "Save changes" or "{prop}" for interpolation
//
// Auto Layout:
//   layout.mode      "vertical" | "horizontal" | "grid" | "freeform" | "none"
//   layout.gap       spacing-token name from design.json
//   layout.padding   spacing token, or { x, y, top, right, bottom, left }
//   layout.align     "start" | "center" | "end" | "stretch" | "baseline"
//   layout.justify   "start" | "center" | "end" | "space-between" |
//                    "space-around" | "space-evenly"
//   layout.columns   positive integer for grid mode
//   layout.wrap      boolean
//   layout.grow      boolean
//   layout.width /
//   layout.height    "fill" | "hug" | non-negative pixel number
//   margin           spacing token, or { x, y, top, right, bottom, left }
//
// Freeform layout (v3):
//   A parent with layout.mode "freeform" establishes a coordinate system. Its direct
//   children may set position { mode: "absolute", x, y }, where x/y are finite pixel
//   numbers relative to that parent. Omit position to remain in normal document flow.
//
// Appearance inherits from the parent and component class by default. Add only the
// token-bound values that intentionally differ:
//   appearance.fontFamily  "display" | "body" | "mono"
//   appearance.textStyle   typography scale name from design.json
//   appearance.color /
//   appearance.background /
//   appearance.borderColor color-token name from design.json
//   appearance.radius      radius-token name from design.json
//   appearance.shadow      shadow-token name from design.json
//   appearance.textAlign   "start" | "center" | "end" | "left" | "right"
//
// states: optional hover, pressed, hoverPressed, disabled appearance objects.
// Uses the same grammar as appearance (including $none and six-digit hex colors).
// Precedence: base -> hover -> pressed -> hoverPressed. Disabled uses base + disabled.
// Define attrs.disabled: true or attrs["aria-disabled"]: "true" to disable a node;
// a disabled appearance alone does not disable it. The gallery's State selector
// forces transient preview states without saving them.
// on: { click: { open: "ComponentName" } } opens a named component as a flyout.
// Targets use their own defaults. No node IDs or nested flyouts. Outside click,
// Escape, focus leaving, and native radio changes dismiss. Selection is transient.
// control: { chrome: "none", focus: { kind: "underline", color: "accent" } }
// opts textual inputs, textareas, buttons or editable elements out of UA chrome.
// A replacement focus cue is required with chrome:none. Focus kind is underline
// or outline; color is a design token (no raw CSS). Other controls are unchanged.
//
// Spacing always references design.json tokens (`"2"`, `"5"`), never raw pixels.
// Classes and parents provide inherited visual styling; sparse `appearance` values
// override that styling without copying raw CSS into the component definition.
{
  "meta": {
    "version": 3,
    "updatedBy": "starter",
    "note": "Hybrid Auto Layout and freeform component patterns for Northlight. Edit in the Colophon canvas or by hand."
  },
  "components": [
    {
      "name": "SubtlePicker",
      "note": "A quiet publishing-format picker. Hover or press to see its states; click to open transient radio options.",
      "root": {
        "id": "subtle-picker",
        "el": "button",
        "attrs": { "type": "button" },
        "layout": { "mode": "horizontal", "padding": { "x": "4", "y": "2" }, "width": "hug", "align": "center" },
        "appearance": { "background": "$none", "color": "ink", "textStyle": "small", "radius": "md" },
        "control": { "chrome": "none", "focus": { "kind": "outline", "color": "accent" } },
        "states": {
          "hover": { "background": "line" },
          "pressed": { "background": "paper" },
          "hoverPressed": { "background": "surface" },
          "disabled": { "color": "muted", "background": "$none" }
        },
        "on": { "click": { "open": "PickerOptions" } },
        "children": ["Format ▾"]
      }
    },
    {
      "name": "PickerOptions",
      "note": "Native radio options. Each preview has an isolated group. Selecting closes the flyout; reopening restores defaults.",
      "root": {
        "id": "picker-options",
        "el": "div",
        "attrs": { "role": "group", "aria-label": "Publishing format" },
        "layout": { "mode": "vertical", "gap": "3", "padding": "4", "width": "hug" },
        "appearance": { "background": "surface", "color": "ink", "textStyle": "small", "radius": "md", "shadow": "md" },
        "children": [
          {
            "id": "format-field-note", "el": "label",
            "layout": { "mode": "horizontal", "gap": "2", "align": "center" },
            "children": [{ "id": "format-note-input", "el": "input", "attrs": { "type": "radio", "name": "format", "value": "note", "checked": true } }, "Field note"]
          },
          {
            "id": "format-changelog", "el": "label",
            "layout": { "mode": "horizontal", "gap": "2", "align": "center" },
            "children": [{ "id": "format-changelog-input", "el": "input", "attrs": { "type": "radio", "name": "format", "value": "changelog" } }, "Changelog"]
          },
          {
            "id": "format-essay", "el": "label",
            "layout": { "mode": "horizontal", "gap": "2", "align": "center" },
            "children": [{ "id": "format-essay-input", "el": "input", "attrs": { "type": "radio", "name": "format", "value": "essay" } }, "Technical essay"]
          }
        ]
      }
    },
    {
      "name": "BorderlessComposer",
      "note": "Typeable, borderless textarea with an accent underline on focus. The standard Field remains unchanged.",
      "root": {
        "id": "borderless-composer", "el": "textarea",
        "attrs": { "aria-label": "Field note draft", "placeholder": "Write a field note", "rows": 3 },
        "layout": { "padding": "3", "width": "fill" },
        "appearance": { "textStyle": "body", "color": "ink", "background": "$none" },
        "control": { "chrome": "none", "focus": { "kind": "underline", "color": "accent" } }
      }
    },
    {
      "name": "Button",
      "note": "Primary action. One per view — it's where the eye should land.",
      "props": {
        "children": "Save changes",
        "variant": "primary"
      },
      "root": {
        "id": "button-root",
        "el": "button",
        "class": "ds-btn ds-btn-{variant}",
        "layout": {
          "mode": "horizontal",
          "padding": {
            "x": "5",
            "y": "3"
          },
          "align": "center",
          "justify": "center",
          "width": "hug"
        },
        "children": [
          "{children}"
        ]
      }
    },
    {
      "name": "Field",
      "note": "Text input with a label above it. Labels are quiet; the field is the subject.",
      "props": {
        "label": "Project name",
        "placeholder": "Northlight"
      },
      "root": {
        "id": "field-root",
        "el": "label",
        "class": "ds-field",
        "layout": {
          "mode": "vertical",
          "gap": "2",
          "width": "fill"
        },
        "children": [
          {
            "id": "field-label",
            "el": "span",
            "class": "ds-field-label",
            "children": [
              "{label}"
            ]
          },
          {
            "id": "field-input",
            "el": "input",
            "class": "ds-input",
            "attrs": {
              "placeholder": "{placeholder}"
            },
            "layout": {
              "padding": {
                "x": "4",
                "y": "3"
              },
              "width": "fill"
            }
          }
        ]
      }
    },
    {
      "name": "Card",
      "note": "Content card. Flat by default — a hairline border, not a drop shadow. Never nest a card inside another card.",
      "props": {
        "title": "Weekly digest",
        "body": "12 changes across 3 repos."
      },
      "root": {
        "id": "card-root",
        "el": "article",
        "class": "ds-card",
        "layout": {
          "mode": "vertical",
          "gap": "2",
          "padding": "5",
          "width": "fill"
        },
        "children": [
          {
            "id": "card-title",
            "el": "h3",
            "class": "ds-card-title",
            "children": [
              "{title}"
            ]
          },
          {
            "id": "card-body",
            "el": "p",
            "class": "ds-card-body",
            "children": [
              "{body}"
            ]
          },
          {
            "id": "card-link",
            "el": "a",
            "class": "ds-link",
            "attrs": {
              "href": "#"
            },
            "margin": {
              "top": "1"
            },
            "children": [
              "Open report →"
            ]
          }
        ]
      }
    },
    {
      "name": "Badge",
      "note": "Status pill. Uses semantic color tokens, never a raw hex.",
      "props": {
        "children": "Live",
        "tone": "positive"
      },
      "root": {
        "id": "badge-root",
        "el": "span",
        "class": "ds-badge ds-badge-{tone}",
        "layout": {
          "mode": "horizontal",
          "padding": {
            "x": "3",
            "y": "1"
          },
          "align": "center",
          "width": "hug"
        },
        "children": [
          "{children}"
        ]
      }
    },
    {
      "name": "ExampleScreen",
      "note": "A representative screen that combines Auto Layout with a freeform status board — the 'does it hang together' check for the whole system.",
      "root": {
        "id": "example-screen-root",
        "el": "section",
        "class": "ds-screen",
        "layout": {
          "mode": "vertical",
          "gap": "5",
          "width": "fill"
        },
        "children": [
          {
            "id": "example-screen-header",
            "el": "header",
            "class": "ds-screen-head",
            "layout": {
              "mode": "horizontal",
              "gap": "4",
              "align": "start",
              "justify": "space-between",
              "width": "fill"
            },
            "children": [
              {
                "id": "example-screen-heading",
                "el": "div",
                "layout": {
                  "mode": "vertical",
                  "gap": "1"
                },
                "children": [
                  {
                    "id": "example-screen-eyebrow",
                    "el": "p",
                    "class": "ds-eyebrow",
                    "children": [
                      "Workspace"
                    ]
                  },
                  {
                    "id": "example-screen-title",
                    "el": "h2",
                    "class": "ds-screen-title",
                    "children": [
                      "Good morning, Karen"
                    ]
                  }
                ]
              },
              {
                "id": "example-screen-status",
                "component": "Badge",
                "props": {
                  "children": "All systems normal",
                  "tone": "positive"
                }
              }
            ]
          },
          {
            "id": "example-screen-grid",
            "el": "div",
            "class": "ds-grid",
            "layout": {
              "mode": "freeform",
              "width": "fill",
              "height": 176
            },
            "children": [
              {
                "id": "example-screen-deploys",
                "component": "Card",
                "position": {
                  "mode": "absolute",
                  "x": 0,
                  "y": 0
                },
                "props": {
                  "title": "Deploys",
                  "body": "3 shipped today. Last one 20 minutes ago."
                },
                "layout": {
                  "width": 280,
                  "height": 148
                }
              },
              {
                "id": "example-screen-reviews",
                "component": "Card",
                "position": {
                  "mode": "absolute",
                  "x": 248,
                  "y": 28
                },
                "props": {
                  "title": "Review queue",
                  "body": "2 PRs waiting on you."
                },
                "layout": {
                  "width": 280,
                  "height": 148
                }
              }
            ]
          },
          {
            "id": "example-screen-actions",
            "el": "div",
            "class": "ds-row",
            "layout": {
              "mode": "horizontal",
              "gap": "4",
              "align": "end",
              "wrap": true,
              "width": "fill"
            },
            "children": [
              {
                "id": "example-screen-field",
                "component": "Field",
                "props": {
                  "label": "Invite a teammate",
                  "placeholder": "name@company.com"
                },
                "layout": {
                  "grow": true
                }
              },
              {
                "id": "example-screen-submit",
                "component": "Button",
                "props": {
                  "children": "Send invite",
                  "variant": "primary"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
